{
  "title": "Orchestrator Overview",
  "uid": "orchestrator-overview",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Nodes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "nodes_ready",
          "legendFormat": "ready",
          "refId": "A"
        },
        {
          "expr": "nodes_unhealthy",
          "legendFormat": "unhealthy",
          "refId": "B"
        },
        {
          "expr": "nodes_offline",
          "legendFormat": "offline",
          "refId": "C"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pods",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pods_running",
          "legendFormat": "running",
          "refId": "A"
        },
        {
          "expr": "pods_pending",
          "legendFormat": "pending",
          "refId": "B"
        },
        {
          "expr": "pods_failed",
          "legendFormat": "failed",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod restarts (rate/min)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(pods_restarts_total[5m])*60",
          "legendFormat": "restarts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Scheduler attempts / failures (rate/min)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(scheduler_attempts_total[5m])*60",
          "legendFormat": "attempts",
          "refId": "A"
        },
        {
          "expr": "rate(scheduler_failures_total[5m])*60",
          "legendFormat": "failures",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Reconciliations by controller (rate/min)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (controller) (rate(reconciliation_total[5m]))*60",
          "legendFormat": "{{controller}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Reconciliation failures",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (controller) (rate(reconciliation_failures_total[5m]))*60",
          "legendFormat": "{{controller}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "API request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (status) (rate(orchestrator_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "API p95 latency (s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orchestrator_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    }
  ]
}