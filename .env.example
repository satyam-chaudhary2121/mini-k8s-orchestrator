# Copy to .env and replace every CHANGE_ME. Never commit real credentials.

# --- Postgres (used by docker compose and the control plane)
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=orchestrator
DATABASE_URL=postgresql+psycopg2://orchestrator:CHANGE_ME_postgres@postgres:5432/orchestrator

# --- API keys (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_API_KEY=CHANGE_ME_admin
OPERATOR_API_KEY=CHANGE_ME_operator
READ_ONLY_API_KEY=CHANGE_ME_readonly
WORKER_API_KEY=CHANGE_ME_worker

# --- Control plane tuning
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=10
NODE_UNHEALTHY_AFTER=30
NODE_TIMEOUT=60
RECONCILIATION_INTERVAL=2
SCHEDULER_STRATEGY=least_loaded   # first_fit | least_loaded | resource_aware
# REDIS_URL=   # not required for a single control-plane instance

# --- Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana

# --- CLI
ORCHESTRATOR_URL=http://localhost:8000
ORCHESTRATOR_API_KEY=CHANGE_ME_admin
